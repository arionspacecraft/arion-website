{
  "name": "arion-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:notion": "node --env-file-if-exists=.env.local scripts/sync-notion-projects.mjs",
    "predev": "npm run sync:notion",
    "dev": "vite",
    "prebuild": "npm run sync:notion",
    "build": "tsc -b && vite build && node scripts/create-route-pages.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
